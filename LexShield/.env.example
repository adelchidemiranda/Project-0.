# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lexshield:lexshield_secret@postgres:5432/lexshield

# ── Redis / Celery ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ───────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_256BIT_RANDOM_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Provider ───────────────────────────────────────────────────
# Supported: openai | anthropic | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...your-key-here...
# ANTHROPIC_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434

# ── File Storage ───────────────────────────────────────────────────
# Set to "local" for dev, "s3" for production
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=lexshield-docs
# AWS_REGION=eu-west-1

# ── Frontend ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Feature Flags ──────────────────────────────────────────────────
NO_DATA_RETENTION_MODE=false
ENABLE_AUDIT_LOG=true
